{
  "data_dir": ".sessions",
  "user_id": "local-user",
  "channel": "cli",
  "runtime": {
    "max_tool_rounds": 10,
    "max_tool_calls_per_round": 8,
    "turn_timeout_seconds": 120,
    "max_context_tokens": 300000,
    "max_tool_result_tokens": 8000
  },
  "memory": {
    "compact_token_threshold": 200000,
    "recent_window_token_limit": 20000
  },
  "sessions": {
    "retention_days": 7
  },
  "tool_permissions": {
    "approval_required_tools": [
      "write_file",
      "edit_file",
      "exec",
      "write_stdin"
    ],
    "auto_approve_tools": false
  },
  "web": {
    "host": "127.0.0.1",
    "port": 8000,
    "max_concurrent_sessions": 6,
    "event_buffer_size": 512
  },
  "mcp": {
    "resource_context_token_limit": 8000,
    "prompt_context_token_limit": 4000,
    "attachment_context_token_limit": 12000,
    "servers": {
      "local-example": {
        "enabled": false,
        "transport": "stdio",
        "command": "python",
        "args": ["-m", "example_mcp_server"],
        "env": {},
        "connect_retry_attempts": 3,
        "connect_retry_delay_seconds": 1,
        "connect_retry_max_delay_seconds": 8,
        "enabled_tools": []
      }
    }
  },
  "skills": {
    "directory": ".skills",
    "max_loaded_skills_per_turn": 3,
    "max_skill_tokens": 8000,
    "max_loaded_skill_tokens_per_turn": 16000
  },
  "proactive": {
    "enabled": true,
    "timezone": "Asia/Shanghai",
    "review_provider": null,
    "review_api_key": null,
    "review_base_url": null,
    "review_model": null,
    "background_max_concurrency": 4,
    "breakbeat_refresh_minutes": 60,
    "dream_refresh_hours": 24,
    "review_window_token_limit": 100000,
    "profile_total_token_limit": 16000,
    "user_profile_token_limit": 12000,
    "soul_profile_token_limit": 4000,
    "skill_observation_turn_interval": 10,
    "skill_observation_token_limit": 160,
    "skill_evolution_batch_token_limit": 100000,
    "skill_evolution_batches_per_kind": 3
  },
  "llm": {
    "provider": "openai-compatible",
    "api_key": "replace-with-your-key",
    "base_url": "https://api.openai.com/v1",
    "model": "replace-with-your-model",
    "streaming_enabled": false
  }
}
